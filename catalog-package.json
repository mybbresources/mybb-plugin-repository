{
  "manifest": {
    "schema_version": 2,
    "slug": "mybbresources-repository",
    "name": "MyBB Resources Repository",
    "description": "Browse and manage catalog plugins in the MyBB Admin CP.",
    "authors": [
      "MyBB Resources"
    ],
    "license": "MIT",
    "source": {
      "type": "original"
    },
    "requirements": {
      "mybb": ">=1.8.41 <1.9.0",
      "php": ">=8.2",
      "packages": {
        "mybb-tooling-core": ">=0.1.2 <1.0.0"
      }
    },
    "uninstall": {
      "remove_owned_files": true,
      "preserve_user_data": true
    }
  },
  "files": [
    {
      "source": "inc/plugins/mybbresources_repository.php",
      "destination": "inc/plugins/mybbresources_repository.php",
      "role": "plugin"
    },
    {
      "source": "admin/modules/config/mybbresources_repository.php",
      "destination": "admin/modules/config/mybbresources_repository.php",
      "role": "admin"
    }
  ]
}
